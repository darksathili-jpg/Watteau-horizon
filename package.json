{
  "name": "watteau-horizon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run catalogue:check && npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:static": "node tests/check-static.mjs",
    "catalogue:import": "node --experimental-strip-types tools/import-catalogue.mjs",
    "catalogue:check": "node --experimental-strip-types tools/import-catalogue.mjs --check"
  },
  "dependencies": {
    "phaser": "3.90.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@playwright/test": "1.65.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "~5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  }
}
